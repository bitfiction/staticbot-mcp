{
  "mcpServers": {
    "staticbot": {
      "command": "npx",
      "args": [
        "-y",
        "--package=@staticbot/mcp",
        "staticbot-mcp"
      ],
      "enabled": true,
      "env_vars": [
        "STATICBOT_API_KEY",
        "STATICBOT_API_URL"
      ],
      "startup_timeout_sec": 60,
      "tool_timeout_sec": 3600
    }
  }
}
