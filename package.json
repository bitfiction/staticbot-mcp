{
  "name": "@staticbot/mcp",
  "version": "1.8.3",
  "mcpName": "io.github.bitfiction/staticbot",
  "description": "MCP server for the Staticbot API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitfiction/staticbot-mcp.git"
  },
  "homepage": "https://www.staticbot.dev/platform/mcp-server",
  "bugs": {
    "url": "https://github.com/bitfiction/staticbot-mcp/issues"
  },
  "keywords": [
    "staticbot",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "ai-agents",
    "deployment",
    "supabase"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "staticbot-mcp": "dist/index.js",
    "staticbot-mcp-http": "dist/hosted/index.js"
  },
  "files": [
    "dist",
    ".codex-plugin",
    ".claude-plugin",
    ".mcp.json",
    "skills",
    "evals",
    "scripts/validate-discovery-prompts.mjs",
    "scripts/check-versions.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "npm run build && npm run smoke && npm run validate:hosted && npm run validate:discovery && npm run validate:versions && npm run validate:redaction && npm run validate:migrations && npm run validate:site-scans && npm run validate:project-operations && npm run validate:backend-operations && npm run validate:cutover && npm run validate:submission && npm run validate:api-parity",
    "validate:hosted": "node --test scripts/check-hosted-discovery.mjs",
    "validate:discovery": "node scripts/validate-discovery-prompts.mjs",
    "prepack": "npm run build",
    "pack:chatgpt": "node scripts/build-chatgpt-submission.mjs",
    "prepublishOnly": "npm test",
    "start:http": "node dist/hosted/index.js",
    "validate:versions": "node scripts/check-versions.mjs",
    "validate:redaction": "node scripts/check-redaction.mjs",
    "validate:migrations": "node scripts/check-migration-contracts.mjs",
    "validate:site-scans": "node scripts/check-site-scan-contracts.mjs",
    "validate:submission": "node scripts/check-submission.mjs",
    "validate:project-operations": "node scripts/check-project-operation-contracts.mjs",
    "validate:api-parity": "node --test scripts/test-api-parity.mjs && node scripts/check-api-parity.mjs",
    "validate:backend-operations": "node scripts/check-backend-operation-contracts.mjs",
    "validate:cutover": "node scripts/check-cutover-contracts.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76",
    "jose": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
